{
  "name": "afterhours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers 1",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "check:env": "tsx --conditions=react-server scripts/check-env.ts",
    "operator:delete-revoked": "tsx --conditions=react-server scripts/delete-revoked.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.28",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.80.0",
    "luxon": "3.7.2",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.28",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.28.2"
    }
  }
}
